{
	"name": "ana-app-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate:enums": "bun ./scripts/generate-subfactor-enum.ts && bun ./scripts/generate-factor-enum.ts && bun ./scripts/generate-metric-enum.ts",
		"generate:reference-json": "bun ./scripts/generate-reference-json.ts",
		"validate:reference-json": "bun ./scripts/validate-reference-json.ts",
		"validate:hypotheses-json": "bun ./scripts/validate-hypotheses-json.ts",
		"validate:circlepacking-json": "bun ./scripts/validate-circlepacking-json.ts",
		"generate:input-data": "bun ./scripts/generate-input-data.ts",
		"generate:input-sources": "bun ./scripts/generate-sources-csv.ts",
		"data:refresh": "bun run generate:enums && bun run generate:reference-json && bun run validate:reference-json && bun run validate:hypotheses-json && bun run validate:circlepacking-json && bun run generate:input-data && bun run generate:input-sources",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@flowbite-svelte-plugins/datatable": "^0.4.1",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3": "^7.4.3",
		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-zoom": "^3.0.8",
		"@types/node": "^26.6.2",
		"clsx": "^2.1.1",
		"daisyui": "^5.7.44",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-headless-table": "^0.18.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@colbymchenry/codegraph": "^1.6.0",
		"@fontsource/gloria-hallelujah": "^5.3.0",
		"@fontsource/noto-sans": "^5.3.0",
		"@fontsource/roboto-condensed": "^5.3.0",
		"@protobi/exceljs": "^4.4.0-protobi.10",
		"@tanstack/table-core": "^9.2.4",
		"@tidyjs/tidy": "^2.6.1",
		"@turf/boolean-intersects": "^7.4.0",
		"@turf/buffer": "^7.4.0",
		"@turf/dissolve": "^7.4.0",
		"@turf/polygon-to-line": "^7.4.0",
		"@turf/simplify": "^7.4.0",
		"@turf/union": "^7.4.0",
		"@types/papaparse": "^5.5.2",
		"bun-plugin-tailwind": "^0.1.2",
		"d3": "^7.9.0",
		"d3-array": "^3.2.4",
		"d3-axis": "^3.0.0",
		"d3-force": "^3.0.0",
		"d3-geo": "^3.1.1",
		"d3-scale": "^4.0.2",
		"d3-selection": "^3.0.0",
		"d3-shape": "^3.2.0",
		"d3-zoom": "^3.0.0",
		"fflate": "^0.8.3",
		"gh-pages": "^6.3.0",
		"i18n-iso-countries": "^7.14.0",
		"papaparse": "^5.7.0",
		"svelteplot": "^0.14.2",
		"zod": "^4.6.5"
	}
}
